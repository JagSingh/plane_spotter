# Site settings for readsb-up.sh. Install as /etc/default/readsb-up and fill in.
# KEY="value" lines only; the file is parsed, not sourced.
# Docs: docs/receiver-setup.md §6.3

# Antenna position (decimal degrees). Required. Keep real values out of git.
LAT=""
LON=""

# Fixed gain for the south Chromebook dongle (R820T step or "auto").
GAIN="36.4"
MAX_RANGE="450"

# Beast push to the north laptop's readsb. Set FEED_HOST="" to run local-only.
FEED_HOST="192.168.86.137"
FEED_PORT="30004"
FEED_PROTO="beast_out"
